#!/usr/bin/env bash
# Install the moks CLI from GitHub releases into ~/.moks/bin
set -euo pipefail

APP=moks
REPO="${MOKS_RELEASE_REPO:-artemysone/moks}"
API="${MOKS_RELEASE_API:-https://api.github.com}"
INSTALL_DIR="${MOKS_INSTALL_DIR:-$HOME/.moks/bin}"

MUTED='\033[0;2m'
RED='\033[0;31m'
NC='\033[0m'

die() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

usage() {
    cat <<EOF
moks installer

Installs the moks binary from GitHub releases (artemysone/moks) into:
  $INSTALL_DIR

Usage:
  curl -fsSL https://raw.githubusercontent.com/artemysone/moks/main/install | bash
  ./install
  ./install -v 0.1.0
  ./install --binary /path/to/moks

Options:
    -h, --help              Display this help message
    -v, --version <ver>     Install this release (e.g. 0.1.0 or v0.1.0)
    -b, --binary <path>     Install a local binary into $INSTALL_DIR
        --no-modify-path    Don't modify shell config files
EOF
}

no_modify_path=false
binary_path=""
version=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            [[ -n "${2:-}" ]] || die "--version requires a version"
            version="$2"
            shift 2
            ;;
        -b|--binary)
            [[ -n "${2:-}" ]] || die "--binary requires a path argument"
            binary_path="$2"
            shift 2
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            die "Unknown option '$1'"
            ;;
    esac
done

case "$REPO" in
    *opencode*|*anomalyco*) die "refusing foreign release repo: $REPO" ;;
esac
case "$API" in
    *opencode*|*anomalyco*) die "refusing foreign release API: $API" ;;
esac

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$os" in
    darwin) os=darwin ;;
    linux) os=linux ;;
    mingw*|msys*|cygwin*) os=windows ;;
    *) die "unsupported OS: $os" ;;
esac
case "$arch" in
    x86_64|amd64) arch=x64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) die "unsupported arch: $arch" ;;
esac

is_musl=false
if [[ "$os" == "linux" ]]; then
    if [[ -f /etc/alpine-release ]]; then
        is_musl=true
    elif command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -qi musl; then
        is_musl=true
    fi
fi

has_avx2=true
if [[ "$arch" == "x64" ]]; then
    if [[ "$os" == "linux" ]] && [[ -f /proc/cpuinfo ]] && ! grep -qw avx2 /proc/cpuinfo; then
        has_avx2=false
    elif [[ "$os" == "darwin" ]] && command -v sysctl >/dev/null 2>&1; then
        [[ "$(sysctl -n hw.optional.avx2_0 2>/dev/null || true)" == "1" ]] || has_avx2=false
    fi
fi

candidates=()
add() { candidates+=("$1"); }
if [[ "$os" == "linux" ]]; then
    if [[ "$is_musl" == true && "$arch" == "x64" && "$has_avx2" == false ]]; then
        add "moks-linux-x64-baseline-musl.tar.gz"
        add "moks-linux-x64-musl.tar.gz"
        add "moks-linux-x64-baseline.tar.gz"
        add "moks-linux-x64.tar.gz"
    elif [[ "$is_musl" == true && "$arch" == "x64" ]]; then
        add "moks-linux-x64-musl.tar.gz"
        add "moks-linux-x64-baseline-musl.tar.gz"
        add "moks-linux-x64.tar.gz"
        add "moks-linux-x64-baseline.tar.gz"
    elif [[ "$is_musl" == true ]]; then
        add "moks-linux-${arch}-musl.tar.gz"
        add "moks-linux-${arch}.tar.gz"
    elif [[ "$arch" == "x64" && "$has_avx2" == false ]]; then
        add "moks-linux-x64-baseline.tar.gz"
        add "moks-linux-x64.tar.gz"
        add "moks-linux-x64-baseline-musl.tar.gz"
        add "moks-linux-x64-musl.tar.gz"
    elif [[ "$arch" == "x64" ]]; then
        add "moks-linux-x64.tar.gz"
        add "moks-linux-x64-baseline.tar.gz"
        add "moks-linux-x64-musl.tar.gz"
        add "moks-linux-x64-baseline-musl.tar.gz"
    else
        add "moks-linux-${arch}.tar.gz"
        add "moks-linux-${arch}-musl.tar.gz"
    fi
elif [[ "$arch" == "x64" && "$has_avx2" == false ]]; then
    add "moks-${os}-x64-baseline.zip"
    add "moks-${os}-x64.zip"
elif [[ "$arch" == "x64" ]]; then
    add "moks-${os}-x64.zip"
    add "moks-${os}-x64-baseline.zip"
else
    add "moks-${os}-${arch}.zip"
fi

allowed_asset() {
    [[ "$1" =~ ^moks-(darwin|linux|windows)-(arm64|x64)(-baseline)?(-musl)?\.(zip|tar\.gz)$ ]]
}

allowed_url() {
    local href="$1"
    case "$href" in
        *opencode*|*anomalyco*) return 1 ;;
    esac
    case "$href" in
        https://github.com/*|https://objects.githubusercontent.com/*) return 0 ;;
        http://127.0.0.1/*|http://localhost/*|http://[::1]/*) return 0 ;;
        https://127.0.0.1/*|https://localhost/*) return 0 ;;
    esac
    local api_host
    api_host="$(printf '%s' "$API" | sed -E 's#^[a-zA-Z]+://##' | cut -d/ -f1 | cut -d: -f1)"
    case "$href" in
        "http://${api_host}"/*|"https://${api_host}"/*|"http://${api_host}:"*|"https://${api_host}:"*) return 0 ;;
    esac
    return 1
}

github_json() {
    local url="$1"
    local args=(-fsSL -H "Accept: application/vnd.github+json" -H "User-Agent: moks-install")
    if [[ -n "${GITHUB_TOKEN:-${GH_TOKEN:-}}" ]]; then
        args+=(-H "Authorization: Bearer ${GITHUB_TOKEN:-$GH_TOKEN}")
    fi
    curl "${args[@]}" "$url"
}

parse_tag() {
    printf '%s' "$1" | tr ',' '\n' | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

asset_url() {
    local json="$1"
    local name="$2"
    printf '%s' "$json" | tr ',' '\n' | awk -v name="$name" '
        /"name"/ {
            n=$0
            sub(/.*"name"[[:space:]]*:[[:space:]]*"/, "", n)
            sub(/".*/, "", n)
        }
        /"browser_download_url"/ {
            u=$0
            sub(/.*"browser_download_url"[[:space:]]*:[[:space:]]*"/, "", u)
            sub(/".*/, "", u)
            if (n == name) { print u; exit }
        }
    '
}

install_file() {
    local src="$1"
    [[ -f "$src" ]] || die "Binary not found at ${src}"
    mkdir -p "$INSTALL_DIR"
    cp "$src" "${INSTALL_DIR}/${APP}"
    chmod 755 "${INSTALL_DIR}/${APP}"
    echo -e "${MUTED}Installed ${NC}${APP}${MUTED} to ${NC}${INSTALL_DIR}/${APP}"
}

add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        echo "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# moks" >> "$config_file"
        echo "$command" >> "$config_file"
        echo -e "${MUTED}Added ${NC}${APP}${MUTED} to \$PATH in ${NC}$config_file"
    else
        echo "Manually add to $config_file:"
        echo "  $command"
    fi
}

maybe_modify_path() {
    if [[ "$no_modify_path" == "true" ]] || [[ ":$PATH:" == *":$INSTALL_DIR:"* ]]; then
        return
    fi
    XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
    current_shell=$(basename "$SHELL")
    case $current_shell in
        fish) config_files="$HOME/.config/fish/config.fish" ;;
        zsh)  config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv" ;;
        bash) config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile" ;;
        *)    config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile" ;;
    esac

    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        echo "No shell config found. Add to PATH:"
        echo "  export PATH=$INSTALL_DIR:\$PATH"
        return
    fi
    case $current_shell in
        fish) add_to_path "$config_file" "fish_add_path $INSTALL_DIR" ;;
        *)    add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH" ;;
    esac
}

if [[ -n "$binary_path" ]]; then
    install_file "$binary_path"
    maybe_modify_path
    echo ""
    echo "Run: ${APP}"
    echo "Docs: https://github.com/artemysone/moks"
    echo ""
    exit 0
fi

command -v curl >/dev/null || die "curl is required"
tag=""
if [[ -n "$version" ]]; then
    tag="v${version#v}"
    release_json="$(github_json "${API}/repos/${REPO}/releases/tags/${tag}")"
else
    release_json="$(github_json "${API}/repos/${REPO}/releases/latest")"
    tag="$(parse_tag "$release_json")"
    [[ -n "$tag" ]] || die "could not read latest release tag from GitHub"
fi

download_url=""
asset_name=""
for name in "${candidates[@]}"; do
    url="$(asset_url "$release_json" "$name")"
    if [[ -n "$url" ]]; then
        asset_name="$name"
        download_url="$url"
        break
    fi
done

[[ -n "$download_url" ]] || die "no release asset for ${os}/${arch} in ${tag}"
allowed_asset "$asset_name" || die "refusing unexpected asset ${asset_name}"
allowed_url "$download_url" || die "refusing download ${download_url}"

scratch="$(mktemp -d "${TMPDIR:-/tmp}/moks-install.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT

archive="${scratch}/${asset_name}"
curl -fsSL -H "User-Agent: moks-install" -o "$archive" "$download_url"

unpacked="${scratch}/out"
mkdir -p "$unpacked"
case "$asset_name" in
    *.tar.gz) tar -xzf "$archive" -C "$unpacked" ;;
    *.zip)
        command -v unzip >/dev/null || die "unzip is required for ${asset_name}"
        unzip -o -q "$archive" -d "$unpacked"
        ;;
    *) die "unknown archive ${asset_name}" ;;
esac

if [[ -f "${unpacked}/${APP}" ]]; then
    install_file "${unpacked}/${APP}"
elif [[ -f "${unpacked}/${APP}.exe" ]]; then
    install_file "${unpacked}/${APP}.exe"
else
    die "archive missing ${APP} binary"
fi

maybe_modify_path
echo ""
echo "Run: ${APP}"
echo "Docs: https://github.com/artemysone/moks"
echo ""
